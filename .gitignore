# M2.5 world data. The atlas is derived from the shard's own scripts and is
# committed; the navgrid is measured from the copyrighted client MULs, so it
# is regenerated locally instead. See docs/M2_5_WORLD_NAVIGATION.md for the
# uo_atlasgen command line.
data/*.bin

# M4 runtime player state. Per-character identity, learned knowledge and
# session history -- generated by living, never checked in.
bot_data/

# M4 run output. The launchers under run_m4/ are committed; what a run
# produces is not.
run_m4/*.console.txt
run_m4/*.err.txt
run_m4/*.log
