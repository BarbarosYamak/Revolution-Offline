# ---------------------------------------------------------------- SECRETS
# The shard runs Md5Passwords=0, so every password it stores is PLAINTEXT.
# Nothing in these ever belongs in version control.
*.env
*credential*
accounts/
sphereaccu.scp

# ------------------------------------------------- CLIENT DATA (copyright)
# Ultima Online / Revolution client files. Redistributable by the rights
# holders only. This project reads them; it does not own them.
mul/
*.mul
*.idx
client.dll
*.exe

# --------------------------------------------------------- CHURN / OUTPUT
build*/
save/
# ...but `build*/` also matches the client's own SOURCE directory
# bot/uo-client/src/builders/, and `mul/` above matches src/mul/ (the MUL
# loaders). Both were silently left out of the repository by those patterns,
# so a fresh clone could not build uo_client. Re-include them explicitly.
!bot/uo-client/src/builders/
!bot/uo-client/src/mul/
logs/
*.log
*.console.txt
*.err.txt
save_backup_*/
*.bak_*

# ------------------------------------------------------------------ LOCAL
# Runner output and the operator's own working files. The *.ps1 tooling in
# local/dev IS committed; everything else it produces is not.
local/dev/*.txt
local/revolution-client/
.idea/
