	ITEMNEWBIE=random_facial_hair
	COLOR=match_hair
// ADDED 2026-08-29: this CHARDEF had NO clothing in @Create at all, unlike
// every professioned vendor (c_alchemist etc., which all dress in @Create).
// Its only ITEM= lines lived in @NPCRestock below. NPC_LoadScript(fRestock)
// (Source-X CCharNPC.cpp:265-291) does run @NPCRestock right after @Create
// on a fresh spawn, so a brand-new c_vendor should still get dressed -- but
// an NPC loaded from an existing worldsave keeps whatever it was wearing
// when it was last saved and does NOT re-run either trigger, so any c_vendor
// placed before this fix stays exactly as bare as it was saved until it is
// respawned. Project owner, 2026-08-29: "vendors are not spawned with
// correct gear, they are half naked". Duplicating the @NPCRestock outfit
// here (same items, same COLOR= idiom already used throughout this file)
// means a fresh spawn is dressed immediately and no longer depends on
// restock timing at all.
	ITEM=i_shirt_plain
	COLOR=colors_all
	ITEM=random_skirt
	COLOR=colors_all
	ITEM=random_shoes
	COLOR=colors_neutral
	ITEM=random_coin_purse

ON=@NPCRestock
